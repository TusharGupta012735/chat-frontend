# Backend the dev server proxies /api to (ondc-api listens on 3000 by default).
VITE_API_TARGET=http://localhost:3000

# Same value as JWT_PRIVATE_KEY in ondc-api/.env. Used only by the dev server (dev-auth.ts) to sign
# sign-in tokens; it has no VITE_ prefix, so it is never put in the browser bundle.
JWT_PRIVATE_KEY=

# How long a sign-in lasts.
DEV_TOKEN_HOURS=8

# ── Production (`npm run build` then `npm start`) ──
# Port to listen on; Render sets this itself.
# PORT=4173
# Hostnames the server answers to (comma-separated; a leading dot allows subdomains).
# ALLOWED_HOSTS=.onrender.com
# Serve quick sign-in / guest login in production. Anyone who can open the site can then sign in
# as ANY customer or support agent (it mints real ADMIN tokens), so only for demos.
# QUICK_LOGIN=false
