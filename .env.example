# The only required setting: the same JWT_PRIVATE_KEY as the backend uses. It signs the one-click
# sign-in tokens on the server (api/dev-auth.ts) and never reaches the browser.
# On Vercel: Project > Settings > Environment Variables. Locally: copy this file to .env.
JWT_PRIVATE_KEY=

# Optional. Backend to talk to; defaults to https://ondc-api-chat.onrender.com.
# Set it locally to use a backend on your machine (vercel.json has the production URL).
# VITE_API_TARGET=http://localhost:3000

# Optional. How long a sign-in lasts, in hours (default 8).
# DEV_TOKEN_HOURS=8
